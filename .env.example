# --- POSTGRESQL DATABASE CONFIGURATION ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=GarenaShop_DB
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SCHEMA_CORE=quan_ly_shop
DB_SCHEMA_AI=ai_analytics

# --- REALTIME EVENT LISTENER (LISTEN / NOTIFY) ---
NOTIFY_CHANNEL_NAME=kenh_ai_garena

# --- AI CONFIGURATION ---
OCR_ENGINE=easyocr
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_ALLOWED_HOSTS=
PORT=8000
